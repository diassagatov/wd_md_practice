{
  "info": {
    "name": "Space Bounty Hunters API",
    "description": "Run the requests top to bottom (or with Collection Runner) against a freshly seeded database. \"Create hunt log\" saves the new ID into {{hunt_id}}, which the next requests use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "criminal_id",
      "value": "1"
    },
    {
      "key": "hunt_id",
      "value": ""
    },
    {
      "key": "hunt_created_at",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Criminals",
      "item": [
        {
          "name": "List all criminals",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('At least 5 criminals', () => pm.expect(pm.response.json().length).to.be.at.least(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ]
            }
          }
        },
        {
          "name": "Filter: min_reward=5000, armed=true, sort=-reward",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Not empty', () => pm.expect(list.length).to.be.above(0));",
                  "pm.test('All armed with reward >= 5000', () => list.forEach(c => { pm.expect(c.armed).to.eql(true); pm.expect(c.reward).to.be.at.least(5000); }));",
                  "pm.test('Sorted by reward descending', () => { for (let i = 1; i < list.length; i++) pm.expect(list[i - 1].reward).to.be.at.least(list[i].reward); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            }
          }
        },
        {
          "name": "Filter: max_reward=10000",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Not empty', () => pm.expect(list.length).to.be.above(0));",
                  "pm.test('All rewards <= 10000', () => list.forEach(c => pm.expect(c.reward).to.be.at.most(10000)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?max_reward=10000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "max_reward",
                  "value": "10000"
                }
              ]
            }
          }
        },
        {
          "name": "Filter: has_crew=true, escape_master=true",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Not empty', () => pm.expect(list.length).to.be.above(0));",
                  "pm.test('All have crew and are escape masters', () => list.forEach(c => { pm.expect(c.has_crew).to.eql(true); pm.expect(c.escape_master).to.eql(true); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?has_crew=true&escape_master=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "has_crew",
                  "value": "true"
                },
                {
                  "key": "escape_master",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Filter: armed=false, escape_master=true",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Not empty', () => pm.expect(list.length).to.be.above(0));",
                  "pm.test('All unarmed escape masters', () => list.forEach(c => { pm.expect(c.armed).to.eql(false); pm.expect(c.escape_master).to.eql(true); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?armed=false&escape_master=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "armed",
                  "value": "false"
                },
                {
                  "key": "escape_master",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Sort: reward ascending",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Sorted by reward ascending', () => { for (let i = 1; i < list.length; i++) pm.expect(list[i - 1].reward).to.be.at.most(list[i].reward); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?sort=reward",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "reward"
                }
              ]
            }
          }
        },
        {
          "name": "Criminal details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test('Correct criminal', () => pm.expect(c.id).to.eql(Number(pm.collectionVariables.get('criminal_id'))));",
                  "pm.test('Has all fields', () => ['name', 'nickname', 'reward', 'latitude', 'longitude', 'location_note', 'difficulty', 'armed', 'has_crew', 'escape_master'].forEach(f => pm.expect(c).to.have.property(f)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/{{criminal_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                "{{criminal_id}}",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Hunt logs (CRUD)",
      "item": [
        {
          "name": "List all hunt logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('At least 10 hunt logs', () => pm.expect(pm.response.json().length).to.be.at.least(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            }
          }
        },
        {
          "name": "Filter hunt logs by criminal_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Not empty', () => pm.expect(list.length).to.be.above(0));",
                  "pm.test('All belong to the criminal', () => list.forEach(h => pm.expect(h.criminal_id).to.eql(Number(pm.collectionVariables.get('criminal_id')))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/?criminal_id={{criminal_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ],
              "query": [
                {
                  "key": "criminal_id",
                  "value": "{{criminal_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Create hunt log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const h = pm.response.json();",
                  "pm.collectionVariables.set('hunt_id', h.id);",
                  "pm.collectionVariables.set('hunt_created_at', h.created_at);",
                  "pm.test('Saved with given data', () => { pm.expect(h.criminal_id).to.eql(3); pm.expect(h.success).to.eql(false); });",
                  "pm.test('created_at set by server', () => pm.expect(h.created_at).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get hunt log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct hunt log', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('hunt_id'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Update hunt log (PATCH success and notes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.test('success and notes updated', () => { pm.expect(h.success).to.eql(true); pm.expect(h.notes).to.include('Caught'); });",
                  "pm.test('created_at cannot be changed by the client', () => pm.expect(h.created_at).to.eql(pm.collectionVariables.get('hunt_created_at')));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"notes\": \"Caught him on the second try.\",\n  \"created_at\": \"2000-01-01T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete hunt log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
